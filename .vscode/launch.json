{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Bueno Tec - Flask",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app.py"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload"
            ],
            "jinja": true,
            "console": "integratedTerminal",
            "postDebugTask": "open-browser",
            "serverReadyAction": {
                "pattern": "Running on (http?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        }
    ]
}